// Fedha — core schema
// Money is stored as Int in the smallest currency unit (e.g. cents) to avoid
// floating point rounding errors in financial calculations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  MOBILE_MONEY
  CASH
  SAVINGS
  INVESTMENT
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryGroup {
  ESSENTIAL
  PERSONAL
  FAMILY_SOCIAL
  FINANCIAL
  BUSINESS
  INCOME
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  ANNUAL
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum DebtStatus {
  ACTIVE
  PAID
  OVERDUE
}

enum ReceivableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  primaryCurrency String   @default("TZS")
  phone           String?
  avatarUrl       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  phoneVerified            Boolean   @default(false)
  phoneVerificationCode    String?
  phoneVerificationExpires DateTime?

  accounts          Account[]
  categories        TransactionCategory[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  pushSubscriptions PushSubscription[]
  debts             Debt[]
  receivables       Receivable[]

  @@map("users")
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  currency       String      @default("TZS")
  currentBalance Int         @default(0)
  institution    String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactionsFrom Transaction[] @relation("SourceAccount")
  transactionsTo   Transaction[] @relation("DestinationAccount")

  @@index([userId])
  @@map("accounts")
}

model TransactionCategory {
  id       String                @id @default(uuid())
  userId   String
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String?
  parent   TransactionCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children TransactionCategory[] @relation("CategoryHierarchy")
  name     String
  group    CategoryGroup
  isCustom Boolean               @default(false)

  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("transaction_categories")
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Int
  currency    String          @default("TZS")
  occurredAt  DateTime
  description String?
  counterparty String?

  accountId                      String
  account                        Account  @relation("SourceAccount", fields: [accountId], references: [id])
  toAccountId                    String?
  toAccount                      Account? @relation("DestinationAccount", fields: [toAccountId], references: [id])
  externalRecipientName          String?
  externalRecipientAccountNumber String?

  categoryId String?
  category   TransactionCategory? @relation(fields: [categoryId], references: [id])

  isRecurringInstance Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([occurredAt])
  @@index([categoryId])
  @@map("transactions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  type      String
  recipient String
  subject   String?
  message   String
  status    NotificationStatus  @default(PENDING)
  error     String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([userId])
  @@map("notifications")
}

model Budget {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   TransactionCategory?  @relation(fields: [categoryId], references: [id])
  name       String
  period     BudgetPeriod          @default(MONTHLY)
  amount     Int
  createdAt  DateTime              @default(now())

  @@index([userId])
  @@map("budgets")
}

model SavingsGoal {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  targetAmount        Int
  currentAmount       Int          @default(0)
  deadline            DateTime?
  monthlyContribution Int          @default(0)
  priority            GoalPriority @default(MEDIUM)
  createdAt           DateTime     @default(now())

  @@index([userId])
  @@map("savings_goals")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// Money the user owes to someone else. Deliberately isolated from the
// Transaction ledger — a debt payment is tracked here, not as a normal
// expense, so it is never miscounted in income/expense totals.
model Debt {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditorName     String
  principal        Int
  interestRate     Float?
  dateBorrowed     DateTime   @default(now())
  dueDate          DateTime?
  remainingBalance Int
  status           DebtStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime   @default(now())

  payments DebtPayment[]

  @@index([userId])
  @@map("debts")
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Int
  paidAt DateTime @default(now())
  notes  String?

  @@index([debtId])
  @@map("debt_payments")
}

// Money someone else owes the user. Same isolation principle as Debt.
model Receivable {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtorName            String
  amount                Int
  dateLent              DateTime         @default(now())
  expectedRepaymentDate DateTime?
  remainingBalance      Int
  status                ReceivableStatus @default(PENDING)
  notes                 String?
  createdAt             DateTime         @default(now())

  payments ReceivablePayment[]

  @@index([userId])
  @@map("receivables")
}

model ReceivablePayment {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       Int
  paidAt       DateTime   @default(now())
  notes        String?

  @@index([receivableId])
  @@map("receivable_payments")
}
