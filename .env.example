# ---- Database ----
# Local dev example (Docker Postgres) or your Railway/Neon/Supabase connection string
DATABASE_URL="postgresql://fedha:fedha@localhost:5432/fedha?schema=public"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---- App ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# ---- Frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
